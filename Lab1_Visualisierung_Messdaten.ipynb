    "'''AUFGABE_6'''\n",
    "files = ['CSV_Daten/aufgabe6_X+.csv',\n",
    "         'CSV_Daten/aufgabe6_X-.csv',\n",
    "         'CSV_Daten/aufgabe6_Y+.csv',\n",
    "         'CSV_Daten/aufgabe6_Y-.csv',\n",
    "         'CSV_Daten/aufgabe6_Z+.csv',\n",
    "         'CSV_Daten/aufgabe6_Z-.csv']\n",
    "\n",
    "# import CSV files\n",
    "dfs = [pd.read_csv(f, sep='\\t', header=None,\n",
    "                   names=['X', 'Y', 'Z', 'Time']) for f in files]\n",
    "\n",
    "# convert ms to s and mg to g\n",
    "for df in dfs:\n",
    "    df['Time'] /= 1000\n",
    "    df[['X', 'Y', 'Z']] /= 1000\n",
    "\n",
    "# display data\n",
    "fig, axes = plt.subplots(3, 2, figsize=(12, 9))\n",
    "\n",
    "for df, ax, name in zip(dfs, axes.flat, files):\n",
    "    df.plot(x='Time', y=['X', 'Y', 'Z'], ax=ax,\n",
    "            title=name.replace('.csv', ''), xlabel='Time in s',\n",
    "            ylabel='Acceleration in g',\n",
    "            ylim=(-1.2, 1.2), xlim=(0,4))\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
